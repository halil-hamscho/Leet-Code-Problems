class Solution:
    def isAnagram(self, s: str, t: str) -> bool:

        if len(s) != len(t):
            return False

        counts = {}
        for letter_s, letter_t in zip(s, t):
            counts[letter_s] = counts.get(letter_s, 0) + 1
            counts[letter_t] = counts.get(letter_t, 0) - 1

        for count in counts.values():
            if count != 0:
                return False

        return True


