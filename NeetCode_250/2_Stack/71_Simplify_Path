class Solution:
    def simplifyPath(self, path: str) -> str:

        stack = [] # real string

        i = 0
        while i < len(path):

            if path[i] == "/":
                i += 1
                continue
            else:
                temp = ""
                j = i

                while path[j] != "/":
                    temp += path[j]
                    j += 1

                if temp == "..":
                    stack.pop()

                if temp not in ["..", "."]:
                    stack.append(temp)

                i += j - i 

        return "/" + "/".join(stack)

if __name__ == "__main__":
    path = "/.../a/../b/c/../d/./"
    result = Solution().simplifyPath(path)
    print(result)