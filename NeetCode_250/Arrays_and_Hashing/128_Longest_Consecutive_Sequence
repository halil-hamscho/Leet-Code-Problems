from typing import List

class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        num_set = set(nums)

        result_length = 0
        for value in num_set:
            left = value - 1

            if left not in num_set:
                # start of sequence
                sequence_length = 1

                while value + 1 in num_set:
                    sequence_length += 1
                    value += 1
                    
                result_length = max(sequence_length, result_length)
        return result_length


if __name__ == "__main__":
    nums = [100,4,200,1,3,2]
    result = Solution().longestConsecutive(nums)
    if result != 4:
