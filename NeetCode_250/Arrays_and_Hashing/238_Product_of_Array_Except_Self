from typing import List

"""
Build two arrays
Left = everything to the left, start from the left 
nums[index - 1] * left[index - 1]

Right = everything to the right, start from the right
nums[index + 1] * right[index + 1]


to save space complexity we can just update the left product array with the right_product
"""


class Solution:
    def productExceptSelf(self, nums: List[int]) -> List[int]:
        result = [] # populate left first
        for i in range(len(nums)):
            if i == 0:
                result.append(1)
            else:
                result.append(nums[i - 1] * result[i - 1])

        right_product = 1
        for i in range(len(nums) - 1, -1, -1):

            result[i] = result[i] * right_product
            right_product = right_product * nums[i]

        return result



if __name__ == "__main__":
    nums = [1,2,3,4]
    result = Solution().productExceptSelf(nums)
