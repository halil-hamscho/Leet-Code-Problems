class Solution:
    def maxProfit(self, prices: list[int]) -> int:
        best_buy = prices[0]
        max_profit = 0
        for price in prices:
            if price < best_buy:
                best_buy = price
                continue
            profit = price - best_buy
            max_profit = max(profit, max_profit)
        return max_profit





if __name__ == "__main__":
    prices = [7, 6, 4, 3, 1]
    result = Solution().maxProfit(prices)