"""
Solutions:

- 2 deque method
    q1 is storage
    q2 is workspace

- one deque method
    rotating deque, can either do the work in push or both pop and top
    work in push: O(n) and pop and top O(1)
    work in top and pop: O(n) and push O(1)

"""


from collections import deque

class MyStack:

    def __init__(self):
        self.q1 = deque()
        
    def push(self, x: int) -> None:
        self.q1.append(x)

        for i in range(len(self.q1) - 1):
            temp = self.q1.popleft()
            self.q1.append(temp)

    def pop(self) -> int:

        return self.q1.popleft()

    def top(self) -> int:

        return self.q1[0]


    def empty(self) -> bool:
        return not self.q1

if __name__ == "__main__":
    result = MyStack()
    result.push(1)
    result.push(2)
    result.top()
    result.pop()
    result.empty()

