class Solution:
    def decodeString(self, s: str) -> str:

        stack = []

        for char in s:

            if char != "]":
                stack.append(char)
                continue
            
            temp_s = []
            while stack[-1] != "[":
                temp_s.append(stack.pop())

            # remove "["
            stack.pop()

            temp_n = []
            while stack and stack[-1].isdigit():
                temp_n.append(stack.pop())

            number = "".join(reversed(temp_n))
            decoded_s = "".join(reversed(temp_s))

            stack.append( int(number) * decoded_s)

        return "".join(stack)
        

if __name__ == "__main__":
    s = "100[leetcode]"
    result = Solution().decodeString(s)
    if "accaccacc" == result:
        print("good")